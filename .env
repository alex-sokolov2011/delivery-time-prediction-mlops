# =========================
# Postgres (for metrics, etc.)
# =========================
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password

# =========================
# MLflow (tracking server)
# =========================
MLFLOW_HOME=/srv/mlflow
MLFLOW_PORT=5000
MLFLOW_NUM_WORKERS=3

# =====================================================
# MinIO — S3-compatible storage for MLflow ARTIFACTS
# (containers use the internal endpoint http://minio:9000)
# =====================================================
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_BUCKET_NAME=mlflow
AWS_ACCESS_KEY_ID=lskdjnkchbd86486tg
AWS_SECRET_ACCESS_KEY=HFVt46fFDIDLDN655

# MinIO service ports and credentials
MINIO_ADDRESS=:9000                # S3 API port (no quotes)
MINIO_CONSOLE_ADDRESS=:9001        # Console/UI port (no quotes)
MINIO_CONSOLE_PORT=9001
MINIO_STORAGE_USE_HTTPS=False
MINIO_ROOT_USER=lskdjnkchbd86486tg
MINIO_ROOT_PASSWORD=HFVt46fFDIDLDN655

# =====================================================
# LocalStack S3 — used by batch/backfill exercises ONLY
# (separate endpoint and credentials on purpose)
# =====================================================
S3_ENDPOINT_URL=http://localstack:4566

# LocalStack service config
SERVICES=s3
DEFAULT_REGION=us-east-1
DEBUG=1

# =====================================================
# Grafana — enable internal Prometheus-style metrics
# =====================================================
GF_METRICS_ENABLED=true

# =====================================================
# Prometheus — retention policy (limit DB growth)
# =====================================================
STORAGE_TSDB_RETENTION_TIME=7d    # keep 7 days of metrics
STORAGE_TSDB_RETENTION_SIZE=1GB   # or max 1GB storage size
